SECRET_KEY=change-me-in-production-use-a-long-random-secret-key-32chars
# Local SQLite (dev). On Render, DATABASE_URL is injected from Postgres.
DATABASE_URL=sqlite:///../data/stock_analytics.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_ADMIN_EMAIL=admin@signalforge.app
DEFAULT_ADMIN_PASSWORD=Admin@12345
SCHEDULER_ENABLED=true
DEBUG=true

# Frontend production (set at build time on Render static site):
# VITE_API_URL=https://signal-forge-api.onrender.com
